// Spine Scale internal ops CRM — single-user, local SQLite.
// To move to Postgres later: change provider to "postgresql", point
// DATABASE_URL at the hosted database, and re-run migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enums in Prisma, so stage/status fields are strings
// constrained by constants in src/lib/constants.ts.

model Lead {
  id           String     @id @default(cuid())
  clinicName   String
  contactName  String?
  phone        String?
  email        String?
  leadSource   String?
  stage        String     @default("NEW") // NEW | CONTACTED | DISCOVERY | PROPOSAL | NEGOTIATING | WON | LOST
  estValue     Float?
  nextFollowUp DateTime?
  archived     Boolean    @default(false) // set when converted to a client (or otherwise closed out)
  notes        LeadNote[]
  calls        Call[]
  activity     ActivityLog[]
  client       Client?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // ICP scorecard. Only the raw answers live here — the total (out of 10) and
  // the A/B/C tier are derived in src/lib/icp.ts so re-tuning the framework
  // never needs a migration or a backfill.

  // Layer 1 — hard disqualifiers. Any one of these true stops the scoring.
  icpDqSurgicalPractice Boolean   @default(false)
  icpDqSoloNoStaff      Boolean   @default(false)
  icpDqFranchiseLocked  Boolean   @default(false)
  icpDqSystemComplete   Boolean   @default(false)
  icpDqOutOfRegion      Boolean   @default(false)
  icpDqTriggered        String? // labels of whichever disqualifiers fired, stamped on save

  // Scored categories. Null until the lead has been scored on that category.
  icpStaffSize          Int? // A — Staff Size Fit, 0–2
  icpPackageEconomics   Int? // B — Package / Consult Economics, 0–3
  icpBudgetSignal       Int? // C — Budget Signal, 0–2

  // D — Automation Gap. Each gap found is worth 1 point, 3 max.
  icpGapBooking     Boolean   @default(false)
  icpGapReviews     Boolean   @default(false)
  icpGapRemarketing Boolean   @default(false)

  icpScoredAt DateTime? // null = never scored; drives whether a tier badge shows
  icpNotes    String?
}

// Append-only activity log — notes are never edited or deleted.
model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}

// A call, scheduled or already held. Hangs off exactly one side — a lead or a
// client, never both and never neither. SQLite can't express that as a
// constraint here, so it is enforced where calls are created, the same way the
// status strings are (src/lib/actions/calls.ts, src/lib/calls.ts).
//
// Deliberately separate from Lead.nextFollowUp: that field is the single "when
// do I next chase this lead" date the pipeline sorts on, and this is the
// detailed log of individual calls alongside it.
model Call {
  id          String   @id @default(cuid())
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  type        String   @default("CHECK_IN") // CHECK_IN | DISCOVERY | KICKOFF | OTHER
  status      String   @default("SCHEDULED") // SCHEDULED | COMPLETED | NO_SHOW | CANCELLED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Client {
  id            String          @id @default(cuid())
  clinicName    String
  contactName   String?
  phone         String?
  email         String?
  packageName   String?
  monthlyFee    Float?
  contractStart DateTime?
  status        String          @default("ONBOARDING") // ONBOARDING | ACTIVE | PAUSED | CHURNED
  ghlRef        String? // GoHighLevel sub-account reference (plain text/URL)
  metaRef       String? // Meta Ads account reference (plain text/URL)
  notes         String?
  leadId        String?         @unique
  lead          Lead?           @relation(fields: [leadId], references: [id])
  checklist    ChecklistItem[]
  reports      WeeklyReport[]
  calls        Call[]
  activity     ActivityLog[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // IANA zone id, constrained to the four US zones in src/lib/timezones.ts.
  // Drives the client's local-time badge and the kickoff-call comparison.
  timeZone String @default("America/New_York")

  // ─── Client health ───────────────────────────────────────────────────────
  // Health is derived from the last few weekly reports in src/lib/health.ts,
  // never stored as the source of truth — the same rule the ICP tier follows.
  // The three fields below are the exceptions that genuinely need persisting.

  // Manual flag for an operational break (ad account down, tracking broken,
  // client unresponsive). "at_risk" forces At risk regardless of the metrics;
  // null hands the status back to the computation.
  healthOverride String?

  // The last health status this client was seen at, so a change can be
  // detected and logged. Written by syncClientHealth() in src/lib/milestones.ts
  // whenever something that feeds the computation changes; read only to
  // compare against, never to display.
  healthStatus    String?
  healthChangedAt DateTime?

  // When the client first went Active. Health needs it to know how many full
  // reporting weeks have actually elapsed under an active engagement — before
  // two of them the client is Ramping, not Healthy and not At risk.
  activeSince DateTime?

  // Onboarding wizard. 0 = not running (never started, skipped, or finished);
  // 1–5 = the step to resume on. Stored so leaving mid-way and coming back
  // continues where you left off.
  onboardingStep Int @default(0)

  // Step 2 — contract. Same reference-field pattern as ghlRef/metaRef: a
  // pointer to where the signed document actually lives.
  contractStatus String  @default("NOT_SENT") // NOT_SENT | SENT | SIGNED
  contractRef    String?

  // Step 3 — invoices logged over time, not just the first one.
  invoices Invoice[]

  // Step 4 — kickoff call, stored as a UTC instant and displayed both in the
  // client's zone and the viewer's.
  kickoffAt DateTime?
}

// One row per invoice raised for a client. Append as they go out; the client
// page and the wizard both show the running total collected.
model Invoice {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  issuedOn  DateTime
  amount    Float    @default(0)
  status    String   @default("UNPAID") // PAID | UNPAID
  memo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChecklistItem {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  status      String    @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | DONE
  completedAt DateTime?
  notes       String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Blocks the launch (or the call that depends on it), so the dashboard's
  // Today's focus lifts it above the rest of the checklist. Seeded from
  // LAUNCH_BLOCKING_CHECKLIST in src/lib/constants.ts and toggleable per item,
  // so renaming an item never silently drops the flag.
  blocking Boolean @default(false)
}

// Internal milestone feed behind the dashboard's Recent activity card.
//
// Written on a fixed, small set of events only — a lead becoming a client, a
// weekly report being generated, a contract signed, an invoice paid, a health
// status change, onboarding completed. Routine field edits are deliberately
// not logged: this is a record of things that happened to the engagement, not
// an audit trail of keystrokes.
model ActivityLog {
  id       String  @id @default(cuid())
  kind     String // LEAD_CONVERTED | REPORT_GENERATED | CONTRACT_SIGNED | INVOICE_PAID | HEALTH_CHANGED | ONBOARDING_COMPLETED
  summary  String // the line the feed shows, composed when the event happens
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  leadId   String?
  lead     Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([createdAt])
}

model WeeklyReport {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  weekStart DateTime
  spend     Float    @default(0)
  leads     Int      @default(0)
  booked    Int      @default(0)
  shows     Int      @default(0)
  revenue   Float    @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, weekStart])
}

model LibraryEntry {
  id        String   @id @default(cuid())
  category  String // AUTOMATION_FLOW_COPY | AD_COPY | ONBOARDING_EMAILS | COMPLIANCE_TEMPLATES | REPORTING_TEMPLATES
  title     String
  body      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
