// Spine Scale internal ops CRM — single-user, local SQLite.
// To move to Postgres later: change provider to "postgresql", point
// DATABASE_URL at the hosted database, and re-run migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enums in Prisma, so stage/status fields are strings
// constrained by constants in src/lib/constants.ts.

// A scraped clinic that has not yet earned a place in the pipeline.
//
// Discovery sits in front of the pipeline, and the rule it exists to enforce
// is one line long: nothing reaches Pipeline unscored. Every import — CSV or
// Apify — lands here instead of on Lead, and a candidate only becomes a Lead
// by scoring 5 or more out of 10 on the framework in src/lib/icp.ts.
//
// The enrichment half of this record is deliberately the same shape as Lead's
// — same four fields, same meanings, written by the same four actors — because
// promotion copies them across unchanged. What it adds is the verdict: a
// total, a tier, and the full per-category reasoning behind both.
//
// Unlike the Lead scorecard, the score here IS stored rather than derived.
// That is not a departure from the rule that the framework owns the bands, it
// is the point of the record: the breakdown is the transcript of one automated
// run against the evidence it had that day, including what a model said and
// why. Re-tuning the framework should not silently rewrite the reason a clinic
// was rejected last month — it should be re-run.
model DiscoveryCandidate {
  id String @id @default(cuid())

  // Identity, as the import mapped it. Same columns the CSV wizard has always
  // offered, so a mapping that used to make a Lead now makes one of these
  // without a single field being dropped on the way.
  clinicName         String
  contactName        String?
  phone              String?
  email              String?
  linkedinUrl        String? // the contact's own profile
  companyLinkedinUrl String? // the clinic's company page
  websiteUrl         String? // filled by hand, or by the enrichment run below
  facebookUrl        String?
  location           String?
  timeZone           String? // IANA id, read off the location by the import
  source             String? // "LinkedIn" unless the import mapped its own
  contactTitle       String? // the decision-maker's role, where one is known
  staffCountRaw      Int? // headcount exactly as the source reported it
  estValue           Float? // carried through to the lead if this one promotes

  // Which run this candidate arrived on — "Aug 7, 2026 — LinkedIn search".
  // Generated once, per run rather than per row, by whatever created the
  // record: the import stamps every candidate it writes, and a queue run
  // stamps anything it picks up that never got one. See src/lib/discoveryBatch.ts.
  //
  // It is a label and not a foreign key, deliberately. A batch has no
  // properties of its own worth a table — it is the answer to "where did this
  // one come from", it is editable so a run can be renamed to what it actually
  // was, and renaming it on one candidate is meant to leave the rest alone.
  // Null on every candidate imported before batches existed, which the filter
  // reads as its own group rather than pretending they share one.
  batchLabel String?

  // ─── Which pathway found this one ────────────────────────────────────────
  //
  // PERSON_FIRST — the original route: a LinkedIn person search (or a CSV of
  // one) found a practitioner, and the clinic came with them. CLINIC_FIRST —
  // the clinic was found on its own merits and the decision-maker may still be
  // unknown. Constrained to DISCOVERY_SOURCES in src/lib/clinicDiscovery.ts.
  //
  // It defaults to PERSON_FIRST, which is what every row written before this
  // column existed actually was. `source` is untouched and still carries the
  // free text — "LinkedIn", "Clinic-First Search", or whatever a sheet said —
  // because that is the provenance a person reads and it can hold more than
  // one after a merge; this column is the one the app branches on.
  discoverySource String @default("PERSON_FIRST")

  // How a clinic-first candidate was found: the Apify actor that ran, and the
  // search term it ran for. Null on anything that arrived another way.
  sourceActor String?
  sourceQuery String?

  // ─── Decision-maker enrichment ───────────────────────────────────────────
  //
  // A stage of its own, run by hand from the candidate page and only on a
  // candidate that has already qualified (see src/lib/decisionMaker.ts). It
  // writes the contact fields above — contactName, contactTitle, linkedinUrl,
  // email, phone — and never overwrites one that was already filled.
  //
  // Kept out of the main status enum on purpose: a candidate's status says
  // where it is in the queue, and how the search for a person went is a
  // different question with its own answers. Constrained to
  // DECISION_MAKER_STATUSES.
  //
  //   not_started    — never looked
  //   searching      — a run has it right now (or had it when the tab closed)
  //   found          — somebody was identified, at the confidence below
  //   not_found      — looked, and nothing verifiable came back
  //   failed         — the actor or the search failed outright
  //   manually_added — a person somebody typed in, or chose from the results
  decisionMakerStatus String @default("not_started")

  // How much the identification is worth: HIGH | MEDIUM | LOW | UNKNOWN,
  // constrained to DECISION_MAKER_CONFIDENCE. Null until somebody is found.
  // It exists because "a doctor at this clinic" and "the owner, per the
  // clinic's own about page" are not the same finding, and a CRM that showed
  // them the same way would be claiming the second when it had the first.
  decisionMakerConfidence String?

  // The sentence behind that confidence, in the words of whatever established
  // it: "Website team page — “Dr John Smith, Founder”." Never generated from
  // an assumption; a person with no evidence is stored with none.
  decisionMakerEvidence String?

  // Every attempt, as JSON: when it ran, the queries used, the actor, how many
  // results came back, who was picked and at what confidence, and any actor
  // error verbatim. Read through parseDecisionMakerLog(), which never throws
  // on a row written by an older shape. This is what makes a run that found
  // nothing debuggable rather than silent.
  decisionMakerLog String?
  decisionMakerAt  DateTime?

  // Public profiles for the person, as a JSON list of URLs — Instagram, a
  // personal site, a professional directory. A list rather than a column each
  // because which ones exist is the clinic's business, not the schema's. The
  // two that already have columns above (facebookUrl for the clinic page,
  // linkedinUrl for the contact) stay where they are.
  contactSocialUrls String?

  // Enrichment — written by the four-actor run (src/lib/enrichRun.ts), the
  // same run and the same readers the lead page uses. Every one of these is a
  // snapshot of what a scrape saw at one moment, which is why enrichedAt
  // exists: the scoring below is only ever as good as its date.
  metaAdsSignal String?
  reviewCount   Int?
  websiteNotes  String?
  enrichedAt    DateTime?

  // Where this candidate is in the queue. Constrained to DISCOVERY_STATUSES in
  // src/lib/discovery.ts.
  //
  //   PENDING   — imported, never processed
  //   ENRICHING — a run has it right now (or had it when the tab was closed)
  //   SCORED    — scored, not yet promoted or rejected
  //   PROMOTED  — became the Lead at promotedLeadId
  //   QUALIFIED_NO_CONTACT
  //             — scored at or above the bar, but nobody is named to talk to
  //   REJECTED  — disqualified, or scored C-tier
  //   FAILED    — an actor failed outright, or two or more scored categories
  //                had no evidence to attempt them on; nothing was scored
  status String @default("PENDING")

  // Why a run stopped, kept verbatim so the next queue run and the person
  // reading the list see the same sentence. Null on every status but FAILED.
  failureReason String?

  // The verdict. Null until the candidate has been scored — a FAILED or
  // PENDING candidate carries no total, because scoring incomplete evidence is
  // the one thing this flow must never do.
  icpTotal Int?
  icpTier  String? // A | B | C | DISQUALIFIED

  // The whole reasoning behind that total, as JSON: every disqualifier with
  // the reason it did or didn't fire, every category with its points and a
  // one-line reason, every automation gap the same, and where each answer came
  // from — computed from the data, or suggested by the model. Read through
  // parseBreakdown() in src/lib/discovery.ts, which never throws on a row
  // written by an older shape.
  icpBreakdown String?

  // Hoisted out of the breakdown because the rejected list filters and sorts
  // on them, and digging through JSON to answer "was this one disqualified" is
  // not something a list view should do.
  //
  // disqualified is Layer 1 only — one of the five hard disqualifiers fired.
  // disqualifiedReason is the sentence behind a REJECTED status either way:
  // the disqualifier that fired, or "Scored C-tier: 3/10". Two ways of not
  // being worth pursuing, one place to read why.
  disqualified       Boolean @default(false)
  disqualifiedReason String?

  // ─── Second look ─────────────────────────────────────────────────────────
  //
  // Written only by "Check for second looks" on the rejected list
  // (src/lib/actions/secondLook.ts), and read only by that list. Nothing here
  // takes part in scoring, in the queue, or in promotion: a flag is a note
  // asking somebody to re-read a rejection, and the only thing that can act on
  // it is a person pressing Promote anyway.
  //
  // secondLookAt marks that the sweep looked at this candidate at all, which is
  // what separates "examined and found clear-cut" from "never examined" — the
  // sweep caps how many rejections it sends to the model per run, so the two
  // are genuinely different states. A candidate the run did not reach keeps
  // whatever it had.
  secondLookFlagged Boolean   @default(false)
  secondLookReason  String? // one sentence on why it is worth re-reading
  secondLookSource  String? // "computed" | "assist", the same split the breakdown records
  secondLookAt      DateTime?

  // The lead this became. Set with status PROMOTED and never cleared: the
  // relation is what stops a candidate being promoted twice. SetNull rather
  // than Cascade — deleting a lead should not erase the record of it having
  // been qualified.
  promotedLeadId String? @unique
  promotedLead   Lead?   @relation(fields: [promotedLeadId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  // When the queue last finished with this candidate, whichever way it went.
  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([batchLabel])
}

model Lead {
  id           String    @id @default(cuid())
  clinicName   String
  contactName  String?
  phone        String?
  email        String?
  leadSource   String?
  stage        String    @default("NEW") // NEW | CONTACTED | DISCOVERY | PROPOSAL | NEGOTIATING | WON | LOST
  // When the stage above last actually changed.
  //
  // Not updatedAt, which is what the date-based stage metrics used to read and
  // is the reason this column exists: updatedAt moves for a typo fixed in a
  // phone number, so a lead approached three weeks ago and edited this morning
  // filed its approach under this morning. This one moves when — and only
  // when — the stage value is different from the one already stored, which is
  // the single rule every write of it obeys (src/lib/leadStage.ts).
  //
  // Defaulted to now() so a lead created at a stage is stamped at its
  // creation, which is true: reaching a stage by being made at it is still
  // reaching it. Backfilled to createdAt on existing rows for the same reason
  // — it is the only instant about them the database can honestly claim.
  stageChangedAt DateTime @default(now())
  estValue     Float?
  nextFollowUp DateTime?
  archived     Boolean   @default(false) // set when converted to a client (or otherwise closed out)

  // Prospecting detail, mostly arriving through the CSV import
  // (src/lib/leadImport.ts) but editable by hand like everything else.
  linkedinUrl        String? // the contact's own profile
  companyLinkedinUrl String? // the clinic's company page
  websiteUrl         String? // the clinic's own site
  facebookUrl        String? // the clinic's Facebook page
  location           String? // town or metro, as somebody would search for it

  // The contact's role, and their other public profiles as a JSON list of
  // URLs. Both arrive with a lead promoted out of Discovery — the
  // decision-maker enrichment stage (src/lib/decisionMaker.ts) establishes
  // them on the candidate, and losing them at the pipeline door would mean
  // re-finding what has already been found. Editable by hand like everything
  // else here, and null on every lead created before that stage existed.
  contactTitle      String?
  contactSocialUrls String?

  // IANA id, one of the four US zones, and null until somebody sets it or an
  // import reads it off the location. Nullable where the client's is not: a
  // client is a clinic being called every week, a lead is a name on a list,
  // and defaulting the whole pipeline to Eastern would put a zone on leads
  // nobody has established anything about.
  timeZone String?

  // When a LinkedIn connection request was sent to this lead, marked by hand
  // on the lead page. Nothing in the app sends one — this records an act that
  // happened on LinkedIn, so that the pipeline can show at a glance who has
  // already been approached and nobody gets approached twice.
  connectionRequestSentAt DateTime?

  // The four above are also the enrichment run's inputs: each actor is built
  // from one of them (src/lib/leadEnrich.ts), and an empty one means that
  // actor is skipped rather than run against nothing.

  // Headcount exactly as the source reported it. Deliberately separate from
  // icpStaffSize below: that field is the scorecard's 0–2 band, and collapsing
  // the two would throw away the number the band was read off. The import can
  // suggest a band from it, but only a human saving the scorecard stores one.
  staffCountRaw Int?

  // Enrichment — written by the enrichment run on the lead page
  // (src/lib/leadEnrich.ts), and by nothing else. Every one of these is a
  // snapshot of what a scrape saw at one moment, not a live reading, which is
  // why enrichedAt exists: a value with no date on it reads as current
  // forever. The ads signal is left freeform on purpose — "3 active ads,
  // running 4mo" is the useful shape, and no schema of ours would survive the
  // next actor's idea of how to report it.
  metaAdsSignal String?
  reviewCount   Int?
  websiteNotes  String? // crawled copy, as long as the actor returned it

  // When the enrichment run last wrote anything at all. One date for the whole
  // record rather than one per field: the run does all four actors together,
  // so "how old is this" has a single honest answer.
  enrichedAt DateTime?

  // When the review count itself was last read. Kept alongside enrichedAt
  // because a run where the Maps actor was skipped or failed moves one and not
  // the other, and a count that didn't get re-read shouldn't look like it did.
  reviewsCheckedAt DateTime?

  // DEPRECATED — read by nothing, written by nothing.
  //
  // This held the one true line about the clinic that opened a connection
  // request, back when the connection request was the only message this app
  // helped write. That message is step 1 of the sequence now, and it lives in
  // OutreachMessage below with the other four, as a whole note rather than as
  // the clause in the middle of one.
  //
  // The column stays because the migration that introduced the table copied
  // every line in it forward into a CONNECTION row and dropping it afterwards
  // would leave the only copy of a year's drafts in a table one migration old.
  // Nothing reads it; it is here to be deleted a release from now.
  outreachHook String?

  // The two answers a connection request can get, marked by hand on the lead
  // page in the same way connectionRequestSentAt above is marked. They are the
  // gates on the sequence: nothing writes a first message until a request was
  // accepted, and nothing offers the audit until they replied.
  //
  // Nullable and independent of each other. A request that was accepted and
  // never replied to is the normal state of half the pipeline, and the pair
  // records exactly that rather than a status somebody has to keep in order.
  connectionAcceptedAt DateTime?
  repliedAt            DateTime?

  // What they actually wrote back, pasted in when the reply is marked.
  //
  // The audit offer is written from this. Its whole job is to answer what the
  // prospect said, and a message that opens "appreciate that context" with no
  // idea what the context was is the version of it that gets ignored. Optional:
  // marking a reply without keeping the text still works, and that step then
  // acknowledges the reply without attributing anything to them.
  replyText String?

  // The Loom this lead's audit was recorded to, pasted in by hand once it
  // exists. It is what unlocks step 4 and the only thing that step's message
  // cannot be written without — a delivery note with no link in it is not a
  // delivery note.
  loomUrl String?

  outreach  OutreachMessage[]
  notes     LeadNote[]
  calls     Call[]
  activity  ActivityLog[]
  tasks     Task[]
  client    Client?
  // The discovery candidate this lead was promoted from, where it came that
  // way. Leads added by hand have none, which is the whole difference the
  // field records.
  candidate DiscoveryCandidate?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  // ICP scorecard. Only the raw answers live here — the total (out of 10) and
  // the A/B/C tier are derived in src/lib/icp.ts so re-tuning the framework
  // never needs a migration or a backfill.

  // Layer 1 — hard disqualifiers. Any one of these true stops the scoring.
  icpDqSurgicalPractice Boolean @default(false)
  icpDqSoloNoStaff      Boolean @default(false)
  icpDqFranchiseLocked  Boolean @default(false)
  icpDqSystemComplete   Boolean @default(false)
  icpDqOutOfRegion      Boolean @default(false)
  icpDqTriggered        String? // labels of whichever disqualifiers fired, stamped on save

  // Scored categories. Null until the lead has been scored on that category.
  icpStaffSize        Int? // A — Staff Size Fit, 0–2
  icpPackageEconomics Int? // B — Package / Consult Economics, 0–3
  icpBudgetSignal     Int? // C — Budget Signal, 0–2

  // D — Automation Gap. Each gap found is worth 1 point, 3 max.
  icpGapBooking     Boolean @default(false)
  icpGapReviews     Boolean @default(false)
  icpGapRemarketing Boolean @default(false)

  icpScoredAt DateTime? // null = never scored; drives whether a tier badge shows
  icpNotes    String?
}

// One drafted message in a lead's outreach sequence.
//
// Five steps, in the order they happen: the connection request, the first
// message once it is accepted, the audit offer once they reply, the delivery
// note once the Loom exists, and the follow-up when the trail goes cold. The
// step strings are constrained by OUTREACH_STEPS in src/lib/outreachSequence.ts
// the same way every other status field in this schema is constrained by
// src/lib/constants.ts — SQLite has no enums, so the constant is the enum.
//
// It is a drafts table and nothing more. Nothing in this app sends a message,
// and no row here means anything was sent: sentAt is a mark somebody makes
// after pasting the text into LinkedIn themselves, exactly like
// Lead.connectionRequestSentAt, and clearing it is a misclick being undone
// rather than an event.
//
// Rows accumulate rather than replace. Regenerating a step writes a new row and
// leaves the old one, because the previous draft is the record of what may
// already have been pasted somewhere, and because every generation is billed —
// throwing one away to save a row is the wrong trade. What the panel shows is
// the newest row per step, and what the prompt for a later step is given is
// every earlier one, so the sequence can avoid repeating an observation it has
// already made.
model OutreachMessage {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // CONNECTION | FIRST_MESSAGE | AUDIT_OFFER | LOOM_DELIVERY | FOLLOW_UP
  step String

  // "A" | "B" | "C", and only on FIRST_MESSAGE, which is generated as three
  // alternatives for a person to choose between. Null on every other step,
  // where there is one message and nothing to tell apart.
  variant String?

  // The message as it stands, whole — greeting, body and sign-off — rather than
  // the fragment the old outreachHook column held. It is what gets copied, so
  // it is what is stored.
  content String

  // The reviewer's note: what this message was built on, what was hedged, and
  // what had to have happened before this step could be sent.
  //
  // Deliberately its own column rather than a paragraph on the end of content.
  // The note exists to be read before sending and to be impossible to paste by
  // accident, and text that lives inside the message is text that gets copied
  // with it.
  internalNote String?

  // When somebody marked this as the one they sent. Null on a draft, and null
  // on the two variants that were not chosen.
  sentAt DateTime?

  createdAt DateTime @default(now())

  // Every read is "this lead's messages, newest first", and the step is what
  // they are then grouped by.
  @@index([leadId, step, createdAt])
}

// Append-only activity log — notes are never edited or deleted.
model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}

// A call, scheduled or already held. Hangs off exactly one side — a lead or a
// client, never both and never neither. SQLite can't express that as a
// constraint here, so it is enforced where calls are created, the same way the
// status strings are (src/lib/actions/calls.ts, src/lib/calls.ts).
//
// Deliberately separate from Lead.nextFollowUp: that field is the single "when
// do I next chase this lead" date the pipeline sorts on, and this is the
// detailed log of individual calls alongside it.
model Call {
  id          String   @id @default(cuid())
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  type        String   @default("CHECK_IN") // CHECK_IN | DISCOVERY | KICKOFF | OTHER
  status      String   @default("SCHEDULED") // SCHEDULED | COMPLETED | NO_SHOW | CANCELLED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Client {
  id            String          @id @default(cuid())
  clinicName    String
  contactName   String?
  phone         String?
  email         String?
  packageName   String?
  monthlyFee    Float?
  contractStart DateTime?
  status        String          @default("ONBOARDING") // ONBOARDING | ACTIVE | PAUSED | CHURNED
  ghlRef        String? // GoHighLevel sub-account reference (plain text/URL)
  metaRef       String? // Meta Ads account reference (plain text/URL)
  notes         String?
  leadId        String?         @unique
  lead          Lead?           @relation(fields: [leadId], references: [id])
  checklist     ChecklistItem[]
  reports       WeeklyReport[]
  calls         Call[]
  activity      ActivityLog[]
  tasks         Task[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // IANA zone id, constrained to the four US zones in src/lib/timezones.ts.
  // Drives the client's local-time badge and the kickoff-call comparison.
  timeZone String @default("America/New_York")

  // ─── Client health ───────────────────────────────────────────────────────
  // Health is derived from the last few weekly reports in src/lib/health.ts,
  // never stored as the source of truth — the same rule the ICP tier follows.
  // The three fields below are the exceptions that genuinely need persisting.

  // Manual flag for an operational break (ad account down, tracking broken,
  // client unresponsive). "at_risk" forces At risk regardless of the metrics;
  // null hands the status back to the computation.
  healthOverride String?

  // The last health status this client was seen at, so a change can be
  // detected and logged. Written by syncClientHealth() in src/lib/milestones.ts
  // whenever something that feeds the computation changes; read only to
  // compare against, never to display.
  healthStatus    String?
  healthChangedAt DateTime?

  // When the client first went Active. Health needs it to know how many full
  // reporting weeks have actually elapsed under an active engagement — before
  // two of them the client is Ramping, not Healthy and not At risk.
  activeSince DateTime?

  // How this engagement handles patient health information. Path A keeps every
  // funnel and automation symptom-agnostic so no PHI is ever collected; Path B
  // takes intake details, which needs the HIPAA add-on and a signed BAA before
  // anything goes live. Constrained to PHI_APPROACHES in src/lib/constants.ts;
  // selecting Path B adds the HIPAA checklist item (src/lib/actions/clients.ts).
  phiApproach String @default("PATH_A") // PATH_A | PATH_B

  // Onboarding wizard. 0 = not running (never started, skipped, or finished);
  // 1–5 = the step to resume on. Stored so leaving mid-way and coming back
  // continues where you left off.
  onboardingStep Int @default(0)

  // Step 2 — contract. Same reference-field pattern as ghlRef/metaRef: a
  // pointer to where the signed document actually lives.
  contractStatus String  @default("NOT_SENT") // NOT_SENT | SENT | SIGNED
  contractRef    String?

  // Step 3 — invoices logged over time, not just the first one.
  invoices Invoice[]

  // Step 4 — kickoff call, stored as a UTC instant and displayed both in the
  // client's zone and the viewer's.
  kickoffAt DateTime?
}

// One row per invoice raised for a client. Append as they go out; the client
// page and the wizard both show the running total collected.
model Invoice {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  issuedOn  DateTime
  amount    Float    @default(0)
  status    String   @default("UNPAID") // PAID | UNPAID
  memo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // When payment is expected. Optional, and deliberately not derived from
  // issuedOn — terms vary per client, and guessing one would put a date on the
  // calendar that nobody agreed to. Invoices without it simply raise no
  // due-date event (src/lib/calendar.ts).
  dueDate DateTime?
}

model ChecklistItem {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  status      String    @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | DONE
  completedAt DateTime?
  notes       String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Blocks the launch (or the call that depends on it), so the dashboard's
  // Today's focus lifts it above the rest of the checklist. Seeded from
  // LAUNCH_BLOCKING_CHECKLIST in src/lib/constants.ts and toggleable per item,
  // so renaming an item never silently drops the flag.
  blocking Boolean @default(false)
}

// Internal milestone feed behind the dashboard's Recent activity card.
//
// Written on a fixed, small set of events only — a lead becoming a client, a
// weekly report being generated, a contract signed, an invoice paid, a health
// status change, onboarding completed. Routine field edits are deliberately
// not logged: this is a record of things that happened to the engagement, not
// an audit trail of keystrokes.
model ActivityLog {
  id       String  @id @default(cuid())
  kind     String // LEAD_CONVERTED | REPORT_GENERATED | CONTRACT_SIGNED | INVOICE_PAID | HEALTH_CHANGED | ONBOARDING_COMPLETED
  summary  String // the line the feed shows, composed when the event happens
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  leadId   String?
  lead     Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([createdAt])
}

model WeeklyReport {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  weekStart DateTime
  spend     Float    @default(0)
  leads     Int      @default(0)
  booked    Int      @default(0)
  shows     Int      @default(0)
  revenue   Float    @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, weekStart])
}

model LibraryEntry {
  id        String   @id @default(cuid())
  category  String // AUTOMATION_FLOW_COPY | AD_COPY | ONBOARDING_EMAILS | COMPLIANCE_TEMPLATES | REPORTING_TEMPLATES
  title     String
  body      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Ad Hub ────────────────────────────────────────────────────────────────
//
// The ad-building framework, in the order the work actually happens:
//
//   Research → Persona → Desire → Benefit → Concept → Creative
//                                              ↓
//                         compliance gate → launch → performance
//
// A Concept is the strategic unit (who / what they want / what they get /
// how it is positioned); a Creative is one execution of it, and iterating on
// a Creative makes a child Creative rather than editing the parent — "don't
// kill a concept, iterate on it". Nothing here is generated: every field is
// typed in by hand.

// Raw notes from the research phase, before any of it is shaped into a
// persona or a concept. Deliberately freeform — the type is the only
// structure imposed on it.
model ResearchNote {
  id        String   @id @default(cuid())
  type      String // INTERNAL | EXTERNAL | MECHANISM | DESIRE
  title     String
  body      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Who the ad is talking to. The five prompts below are the framework's own —
// identity, self-image, ambition, and the history of failure that explains
// why they will be sceptical of the next promise.
model Persona {
  id           String  @id @default(cuid())
  name         String
  demographics String?

  wantsToBeSeenAs   String? // characteristics they want others to see
  believesAboutSelf String? // what they believe about themselves
  wantsToAchieve    String? // what they want to achieve
  triedAndFailed    String? // other solutions tried and failed
  reasonForFailure  String? // why those failed them

  concepts  Concept[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// A mass desire — "I want to…" — written once and reused across concepts and
// personas. Deliberately not owned by a Persona: the same want shows up in
// several of them, and duplicating it per persona would hide that.
model Desire {
  id        String    @id @default(cuid())
  statement String // the want statement, e.g. "I want to get through a workday without my back seizing up"
  notes     String?
  benefits  Benefit[]
  concepts  Concept[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Feature → benefit, tied to the desire it answers. The benefit is the
// "so you can…" half — what the feature buys them, in their words.
model Benefit {
  id          String    @id @default(cuid())
  productName String // the product or feature this belongs to
  feature     String // what it is
  benefit     String // so you can…
  desireId    String
  desire      Desire    @relation(fields: [desireId], references: [id], onDelete: Cascade)
  concepts    Concept[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Persona + desire + benefit + positioning. Everything a creative needs to be
// judged against, decided before a word of copy is written.
model Concept {
  id          String @id @default(cuid())
  name        String
  batchNumber Int    @default(1)

  personaId String
  persona   Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)
  desireId  String
  desire    Desire  @relation(fields: [desireId], references: [id])
  benefitId String
  benefit   Benefit @relation(fields: [benefitId], references: [id])

  // Positioning. Constrained to the values in src/lib/adhub.ts.
  awarenessLevel      String // UNAWARE | PROBLEM_AWARE | SOLUTION_AWARE | PRODUCT_AWARE | MOST_AWARE
  sophisticationStage Int // 1–5

  status    String     @default("DRAFT") // DRAFT | ACTIVE | PAUSED | KILLED
  notes     String?
  creatives Creative[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// One execution of a concept. A variation is a Creative whose parentCreativeId
// points at the one it was duplicated from, so a concept's iteration history
// stays readable instead of being overwritten in place.
model Creative {
  id             String  @id @default(cuid())
  conceptId      String
  concept        Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  creativeNumber Int     @default(1) // batch/creative number within the concept
  creativeType   String  @default("PHOTO") // PHOTO | VIDEO | UGC

  conceptHeadline String @default("") // the hook — bold, predominant text
  adHeadline      String @default("") // 40–50 characters
  adCopy          String @default("")
  cta             String @default("")

  // READY is gated on every compliance item being checked — enforced in
  // src/lib/actions/adhub.ts, not by the database.
  status String @default("DRAFT") // DRAFT | COMPLIANCE_REVIEW | READY | LAUNCHED | TESTING | WINNER | LOSER

  // Self-relation for iteration lineage. SetNull rather than Cascade: deleting
  // a creative should not take its variations with it — they are their own
  // executions by then.
  parentCreativeId String?
  parent           Creative?  @relation("CreativeLineage", fields: [parentCreativeId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  variations       Creative[] @relation("CreativeLineage")

  compliance  ComplianceCheck[]
  performance PerformanceLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per checklist item per creative, seeded from AD_COMPLIANCE_ITEMS in
// src/lib/adhub.ts when the creative is created. Stored per creative rather
// than derived so a check is a record of someone having actually looked.
model ComplianceCheck {
  id         String    @id @default(cuid())
  creativeId String
  creative   Creative  @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  item       String
  checked    Boolean   @default(false)
  checkedAt  DateTime?
  sortOrder  Int       @default(0)
}

// Manual performance entry — numbers typed in from the ad platform, not pulled
// from it. There is no ad-platform integration anywhere in this section.
model PerformanceLog {
  id          String   @id @default(cuid())
  creativeId  String
  creative    Creative @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  loggedOn    DateTime
  spend       Float    @default(0)
  impressions Int?
  ctr         Float? // percent, as typed
  cpl         Float?
  conversions Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
}

// How the discovery chain runs — the one row of settings behind every
// enrichment run and every scoring verdict.
//
// Everything here was a constant in the source until it wasn't. The five steps
// and their actor IDs lived in src/lib/leadEnrich.ts, and the promotion
// threshold lived as a bare 5 in src/lib/actions/discovery.ts; swapping an
// actor for a cheaper one, or turning off a step whose credits had run out,
// meant an edit and a deploy. They are a row now so that is a form instead.
//
// Exactly one row, at the fixed id in src/lib/pipelineSettings.ts. Not a
// singleton by convention but by that id: every read is a findUnique on it and
// every write an upsert of it, so there is no path that creates a second row
// and no question about which one is in force. A database with no row at all
// is the normal state of a fresh install and reads as the defaults below.
//
// What is deliberately NOT here: anything about what the actors are asked, or
// how a score is worked out. The inputs each actor is built with, the ICP
// framework, the tier bands and the disqualifiers are the app's own reasoning
// and stay in code where they can be read and reviewed. This row says which
// steps run, what they are called, and where the bar sits.
model PipelineSettings {
  id String @id

  // One pair per step: whether it runs at all, and the actor it runs. A step
  // turned off here is skipped exactly the way a step with no URL to work from
  // is skipped — reported, and never fatal.
  //
  // The defaults are the IDs that were hardcoded before this table existed, so
  // an install that never opens the settings page behaves as it always did.
  companyDetailsEnabled Boolean @default(true)
  companyDetailsActorId String  @default("harvestapi~linkedin-company")

  facebookLookupEnabled Boolean @default(true)
  facebookLookupActorId String  @default("apify~google-search-scraper")

  facebookAdsEnabled Boolean @default(true)
  facebookAdsActorId String  @default("apify~facebook-ads-scraper")

  websiteContentEnabled Boolean @default(true)
  websiteContentActorId String  @default("apify~website-content-crawler")

  googleReviewsEnabled Boolean @default(true)
  googleReviewsActorId String  @default("compass~crawler-google-places")

  // Clinic-First Discovery — the second way into Discovery, off by default
  // because it costs actor runs and there is no sensible default actor: the
  // one that fits is whichever place-search actor this account has. Same
  // toggle-plus-actor-ID shape as the five steps above, and read through the
  // same validation (src/lib/pipelineSettings.ts).
  clinicDiscoveryEnabled Boolean @default(false)
  clinicDiscoveryActorId String  @default("compass~crawler-google-places")

  // Decision-maker enrichment — the stage that runs after a clinic-first
  // candidate has qualified. Same toggle-plus-actor-ID shape as everything
  // above, and off by default for the same reason: it spends actor runs.
  //
  // The default is the profile-search actor the person-first pathway already
  // uses. It searches by company name and title, which is the shape this stage
  // needs — "who is the owner at this clinic" — rather than a new integration.
  decisionMakerEnabled Boolean @default(false)
  decisionMakerActorId String  @default("harvestapi~linkedin-profile-search")

  // The score a candidate must reach to be promoted rather than rejected,
  // out of ICP_MAX_SCORE. It is the promotion bar and not a tier band: the
  // A/B/C bands are the framework's (src/lib/icp.ts) and are not editable
  // here, because re-tiering every clinic in the app is not a setting.
  promotionThreshold Int @default(5)

  updatedAt DateTime @updatedAt
}

// The credentials the app calls out with — one row, same singleton shape as
// PipelineSettings above.
//
// Both keys were .env-only until this table existed, which meant changing one
// was a file edit and a server restart. They live here so the Settings page can
// change them and the very next request picks the new one up. The .env vars are
// still read: an install that never opens the page behaves exactly as it did,
// and a row with a null column falls back to the environment rather than to
// nothing (see src/lib/appSecretsStore.ts).
//
// Stored as written. This is a single-user internal app whose database file
// sits beside the .env it replaces, so encrypting a column here would move the
// key to unlock it into that same .env and buy nothing. What the app does
// promise is that neither value is ever sent to the browser in full — the
// Settings page is served the last four characters and nothing more, and no
// action returns a key.
model AppSecrets {
  id String @id

  // Null means "not set here" and defers to the environment variable of the
  // same name. Saving an empty value clears the column back to that.
  deepseekApiKey String?
  apifyApiToken  String?

  updatedAt DateTime @updatedAt
}

// A piece of work that is not a call, a follow-up or an onboarding step — the
// board on the Activities page, and the fourth source Today's focus reads.
//
// A task is deliberately free-standing. Everything else the focus list draws
// on hangs off a record and only exists because that record is in a certain
// state; this is the one thing you can write down because it needs doing and
// nothing in the CRM would otherwise know about it. The two optional links are
// what let it be about a lead or a client without being owned by one — they
// are a chip on the card and a way into the record, not a parent.
//
// completedAt is stamped by the board rather than typed: it is set when a card
// lands in Done and cleared when it is dragged back out, so "done" and "when"
// can never disagree. status stays the field everything else reads — the
// timestamp is the record of when it happened, not the state.
model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  // TODO | IN_PROGRESS | DONE — constrained to TASK_STATUSES in src/lib/tasks.ts,
  // the same way every other status field in this schema is.
  status      String    @default("TODO")
  // A day rather than an instant: a task is due on a date, not at 3:15pm. Read
  // in UTC like every other date-only column here (see fmtDate).
  dueDate     DateTime?

  leadId   String?
  lead     Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  // The board reads by status, and Today's focus reads open tasks by due date.
  @@index([status, dueDate])
}

// One tick on one day of the fixed daily routine.
//
// The routine itself is not in this table. Its items live in
// src/lib/dailyChecklist.ts as a constant, the same way the ad compliance gate
// keeps its five items in code — they are the shape of a working day rather
// than data somebody maintains, and a routine you can edit is a routine you
// stop following. This table records only which of them were ticked, and when.
//
// A row per item per day, written on first view of that day and never before:
// there is no job that rolls the checklist over at midnight, because there does
// not need to be one. Asking for a date that has no rows creates them unticked,
// which is exactly what "resets each morning" means and is also what makes
// every past day still readable — yesterday's ticks are yesterday's rows, and
// nothing overwrites them.
//
// date is a day, not an instant: midnight UTC on the day in question, read back
// in UTC, so the checklist does not change day underneath somebody halfway
// through their evening.
model DailyChecklistEntry {
  id      String   @id @default(cuid())
  date    DateTime
  // One of DAILY_CHECKLIST_ITEMS in src/lib/dailyChecklist.ts. Stored as the
  // item's stable key rather than its wording, so the label can be reworded
  // without orphaning a year of history.
  item    String
  checked Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One row per item per day is the whole invariant, and the database is what
  // holds it: two tabs opening today's checklist at once both seed it, and the
  // second write is a no-op rather than a duplicate.
  @@unique([date, item])
  @@index([date])
}

// The standing description of this business, written by the operator and given
// to the AI Copilot at the head of every conversation.
//
// One row, fixed id "singleton", the same shape PipelineSettings and AppSecrets
// use — there is one business, so there is one of these. A fresh install has no
// row, which reads as "nothing written yet" and means the copilot's prompt is
// exactly what it was before this table existed.
//
// It is prose, not fields, and deliberately: what a model needs to know about
// an agency — how it makes money, who it is for, how it talks, what it will
// never say — is not a set of columns anybody could design in advance. The
// Settings page opens it on a template of section headings, and what somebody
// types under them is stored as they typed it.
//
// This is the one piece of text in the app that reaches a model as an
// instruction rather than as data. It is trusted because the operator wrote it,
// which is exactly what a clinic's scraped website is not — see
// UNTRUSTED_CONTENT_KEY in src/lib/copilot.ts for the other half of that
// distinction.
model BusinessContext {
  id String @id

  // Empty is the resting state, not a missing value: a body with nothing in it
  // is skipped when the prompt is built rather than sent as a blank heading.
  body String @default("")

  updatedAt DateTime @updatedAt
}

// Daily KPI goals — the four numbers the Daily KPI page tracks a day against.
//
// Same singleton shape as PipelineSettings above, and for the same reason: one
// person runs this app, so there is one set of goals, held on one row at a
// fixed id. Every read is a findUnique on it and every write an upsert, so
// there is no path that creates a second row.
//
// Only the goals live here. Not one of the four counts is stored: they are all
// read off records that already carry the instant they happened
// (Lead.connectionRequestSentAt, Lead.repliedAt, DiscoveryCandidate.processedAt,
// Call.createdAt), so yesterday, last week and the streak are all the same
// query asked about a different day. A daily snapshot table would be a second
// account of the same facts, and the two would eventually disagree.
model DailyKpiSettings {
  id String @id

  // Two goals a day and two a month, and the column names say which. A reply
  // and a booked meeting are somebody else's to give, so they are judged over
  // a month rather than an afternoon (see src/lib/dailyKpi.ts); holding them
  // to a daily number scored the day against other people's inboxes.
  //
  // The defaults are the targets the page shipped with, the monthly pair
  // carried across at twenty working days to the month — the same standard,
  // over the timeframe that can actually carry it.
  qualifiedLeadsGoal         Int @default(20)
  messagesSentGoal           Int @default(50)
  repliesReceivedMonthlyGoal Int @default(200)
  meetingsBookedMonthlyGoal  Int @default(60)

  updatedAt DateTime @updatedAt
}

// ─── Copilot conversations ─────────────────────────────────────────────────
//
// A saved chat with Iman, the copilot on /copilot.
//
// The panel this page replaced kept its thread in component state and lost it
// on reload, on the grounds that the value was in the answer rather than in
// the transcript. A full page changes that: a page you navigate to is a place
// you come back to, and coming back to an empty one throws away the question
// you asked this morning along with the lookups that answered it.
//
// The title is generated from the first thing typed rather than asked for.
// Nobody names a conversation before having it, and "New chat" is what a
// conversation that has not been started yet is called.
//
// Nothing here is trusted on the way back out. A stored assistant turn is
// replayed to the model as prose only, through the same sanitiseHistory the
// browser's turns go through (src/lib/copilot.ts) — the toolsUsed column is a
// receipt drawn under an answer, never a tool result fed back in. That is the
// same rule the panel held: the browser cannot put a fact in the model's
// mouth, and now neither can the database.
model CopilotConversation {
  id        String   @id @default(cuid())
  title     String   @default("New chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages CopilotMessage[]

  // The history dropdown reads this list newest-first and nothing else does.
  @@index([updatedAt])
}

// One turn of a saved conversation.
//
// "error" is a role here as it is in the page: a failure answers a specific
// question and belongs in the thread beside it. It is stored so that reopening
// a conversation shows what it actually looked like, and it is dropped again
// on the way to the model, which never said it.
//
// toolsUsed is the receipt — the lookup names, JSON-encoded, in the order they
// ran — because SQLite has no array column. Empty string means none, which is
// every user turn and every error.
model CopilotMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   CopilotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role      String // user | assistant | error
  content   String
  toolsUsed String   @default("")
  // The order the turns were said in. createdAt alone is not enough: a
  // question and its answer are saved in the same write and can land on the
  // same millisecond.
  position  Int
  createdAt DateTime @default(now())

  @@index([conversationId, position])
}

// The dashboard's motivational line — one quote a day, cached.
//
// The row is the cache. The line is written by a model given the day's real
// situation (the KPI score against goals, the streak, whether the last fortnight
// has been quiet or busy, what day of the week it is), and asking for it costs
// a network call, so it is asked once per day and read from here every time
// after. The id is the day itself in YYYY-MM-DD, so "have we already got
// today's" is a findUnique on a primary key and there is no path that writes
// two rows for one day.
//
// Only a model's answer is stored. A day the call failed writes nothing at all,
// which is what lets the fallback line show now and the real one arrive on the
// next load once the key is fixed — a cached failure would hold a dashboard on
// its fallback until midnight.
//
// Nothing here is an instruction to anything. It is one sentence and its
// author, rendered as text.
model DailyQuote {
  // "2026-08-31" — the day, read in UTC, the same reading the checklist and the
  // KPI page file a day under.
  id String @id

  text   String
  // Who said it. Kept separate from the sentence so the line can draw the two
  // in different weights rather than parsing an em dash back out of a string.
  author String

  createdAt DateTime @default(now())
}
