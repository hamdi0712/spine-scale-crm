// Spine Scale internal ops CRM — single-user, local SQLite.
// To move to Postgres later: change provider to "postgresql", point
// DATABASE_URL at the hosted database, and re-run migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enums in Prisma, so stage/status fields are strings
// constrained by constants in src/lib/constants.ts.

model Lead {
  id           String     @id @default(cuid())
  clinicName   String
  contactName  String?
  phone        String?
  email        String?
  leadSource   String?
  stage        String     @default("NEW") // NEW | CONTACTED | DISCOVERY | PROPOSAL | NEGOTIATING | WON | LOST
  estValue     Float?
  nextFollowUp DateTime?
  archived     Boolean    @default(false) // set when converted to a client (or otherwise closed out)
  notes        LeadNote[]
  client       Client?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // ICP scorecard. Only the raw answers live here — the total (out of 10) and
  // the A/B/C tier are derived in src/lib/icp.ts so re-tuning the framework
  // never needs a migration or a backfill.

  // Layer 1 — hard disqualifiers. Any one of these true stops the scoring.
  icpDqSurgicalPractice Boolean   @default(false)
  icpDqSoloNoStaff      Boolean   @default(false)
  icpDqFranchiseLocked  Boolean   @default(false)
  icpDqSystemComplete   Boolean   @default(false)
  icpDqOutOfRegion      Boolean   @default(false)
  icpDqTriggered        String? // labels of whichever disqualifiers fired, stamped on save

  // Scored categories. Null until the lead has been scored on that category.
  icpStaffSize          Int? // A — Staff Size Fit, 0–2
  icpPackageEconomics   Int? // B — Package / Consult Economics, 0–3
  icpBudgetSignal       Int? // C — Budget Signal, 0–2

  // D — Automation Gap. Each gap found is worth 1 point, 3 max.
  icpGapBooking     Boolean   @default(false)
  icpGapReviews     Boolean   @default(false)
  icpGapRemarketing Boolean   @default(false)

  icpScoredAt DateTime? // null = never scored; drives whether a tier badge shows
  icpNotes    String?
}

// Append-only activity log — notes are never edited or deleted.
model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}

model Client {
  id            String          @id @default(cuid())
  clinicName    String
  contactName   String?
  phone         String?
  email         String?
  packageName   String?
  monthlyFee    Float?
  contractStart DateTime?
  status        String          @default("ONBOARDING") // ONBOARDING | ACTIVE | PAUSED | CHURNED
  ghlRef        String? // GoHighLevel sub-account reference (plain text/URL)
  metaRef       String? // Meta Ads account reference (plain text/URL)
  notes         String?
  leadId        String?         @unique
  lead          Lead?           @relation(fields: [leadId], references: [id])
  checklist    ChecklistItem[]
  reports      WeeklyReport[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model ChecklistItem {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  status      String    @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | DONE
  completedAt DateTime?
  notes       String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model WeeklyReport {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  weekStart DateTime
  spend     Float    @default(0)
  leads     Int      @default(0)
  booked    Int      @default(0)
  shows     Int      @default(0)
  revenue   Float    @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, weekStart])
}

model LibraryEntry {
  id        String   @id @default(cuid())
  category  String // AUTOMATION_FLOW_COPY | AD_COPY | ONBOARDING_EMAILS | COMPLIANCE_TEMPLATES | REPORTING_TEMPLATES
  title     String
  body      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
