# Copy this file to .env and set your own values:
#   cp .env.example .env

# SQLite database file (relative to prisma/ directory)
DATABASE_URL="file:./dev.db"

# Login password for the app
APP_PASSWORD="change-me"

# Apify API token, for the live lead import (Pipeline → Import from Apify).
# Server-side only — it is never sent to the browser. Create one at
# https://console.apify.com/settings/integrations. Leave it unset to use only
# the CSV import.
APIFY_API_TOKEN=""
