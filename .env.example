# Copy this file to .env and set your own values:
#   cp .env.example .env

# SQLite database file (relative to prisma/ directory)
DATABASE_URL="file:./dev.db"

# Login password for the app
APP_PASSWORD="change-me"

# Apify API token, for the live lead import (Pipeline → Import from Apify).
# Server-side only — it is never sent to the browser. Create one at
# https://console.apify.com/settings/integrations. Leave it unset to use only
# the CSV import.
APIFY_API_TOKEN=""

# DeepSeek API key, for everything in the app that asks a model something: the
# ICP scorecard's scoring assist (a lead's scorecard → Suggest remaining
# scores), the outreach hook, the discovery queue's scoring, and Check for
# second looks on the rejected list. Server-side only — it
# is never sent to the browser. Create one at
# https://platform.deepseek.com/api_keys. Leave it unset and every one of those
# turns itself off with a sentence saying so; nothing else in the app changes,
# and every number on every page is still counted from your own records.
DEEPSEEK_API_KEY=""
